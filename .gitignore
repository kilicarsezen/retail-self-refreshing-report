# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checker and linter caches
.mypy_cache/
.pyre/
.ruff_cache/
.pytype/

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/

# Local environment and secrets
.env
.env.*
!.env.example

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Local logs and databases
*.log
*.sqlite
*.sqlite3

# Local data files
/data/

# Power BI report: track the git-friendly PBIP project source (RetailDemo.pbip,
# RetailDemo.Report/, RetailDemo.SemanticModel/) since that's the whole point of
# the PBIP format -- diffable, reviewable model/report definitions. Exclude the
# compiled .pbix binary (not diff-friendly, regenerable by opening the .pbip in
# Desktop) and the local, machine-specific/data-cache files Desktop writes
# alongside the source.
/reports/*.pbix
/reports/*/.pbi/cache.abf
/reports/*/.pbi/localSettings.json

# Claude Code local session/worktree state
.claude/
CLAUDE.md
power_bi_build_instructions.md

# Held-back monthly exports (data, not code)
/archive/
